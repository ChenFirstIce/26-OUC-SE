# 生产或联网部署前必须更换
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
PATIENT_SESSION_MINUTES=120
FRONTEND_ORIGIN=http://127.0.0.1:5173

# 当前 Windows Python 环境无法让 SQLite 打开中文工作目录，默认数据库放在：
# %TEMP%\ad_questionnaire_data\ad_questionnaire.db
# 如需 PostgreSQL，可设置：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1/ad_questionnaire

