# Values must be set in the process environment; .env is not auto-loaded.
# 生产或联网部署前必须更换
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
PATIENT_SESSION_MINUTES=120
FRONTEND_ORIGIN=http://127.0.0.1:5173

# DeepSeek / LLM 配置
# API key 通过管理员接口加密写入数据库；LLM_SECRET_KEY 只放进程环境变量，不入库。
# 若不设置 LLM_SECRET_KEY，则不能保存或解密数据库中的 LLM key，C 类任务会走本地降级。
LLM_SECRET_KEY=replace-with-a-long-random-llm-master-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=12
DEEPSEEK_MAX_TOKENS=800

# 可选；留空时使用系统临时目录中的 SQLite。路径请尽量只含 ASCII 字符：
# DATABASE_URL=sqlite:///D:/data/ad_questionnaire.db

# 当前 Windows Python 环境无法让 SQLite 打开中文工作目录，默认数据库放在：
# %TEMP%\ad_questionnaire_cyb_<workspace-hash>\ad_questionnaire.db
# 如需 PostgreSQL，可设置：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1/ad_questionnaire
